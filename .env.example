# Export these values in your shell; the server does not automatically read .env.
# Keep local manuscript storage outside any public/static directory.
BUNA_DATA_DIR=.buna-data
# Optional polite-pool contact; sent to approved bibliographic API destinations.
BUNA_CONTACT_EMAIL=
# Optional OpenAlex key; keyless access works within provider quotas.
BUNA_OPENALEX_API_KEY=
# Opt-in local paper library. Off by default; enable only after feature integration.
BUNA_ENABLE_LIBRARY=0
# Optional Unpaywall API contact email, supplied by you; sent only to Unpaywall.
BUNA_UNPAYWALL_EMAIL=
